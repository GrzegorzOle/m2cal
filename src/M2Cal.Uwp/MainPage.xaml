<Page
    x:Class="M2Cal.Uwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:M2Cal.Uwp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <!-- Praca zdalna na pełnym ekranie: bez paska tytułu nie ma czym zamknąć okna. -->
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapePressed" />
    </Page.KeyboardAccelerators>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Tor audio ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">

            <!-- Pasek aktualizacji: własny, bo tekstu systemowego okna Instalatora aplikacji
                 nie da się zmienić. Ukryty, dopóki nie ma nowszej wersji. -->
            <Border x:Name="UpdateBar"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Dostępna jest nowsza wersja aplikacji." />
                    <Button Grid.Column="1" Content="Aktualizuj" Margin="12,0,0,0" Click="OnUpdateNow" />
                    <Button Grid.Column="2" Content="Później" Margin="8,0,0,0" Click="OnUpdateLater" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOR AUDIO" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                <Button x:Name="FullScreenButton"
                        Grid.Column="1"
                        Content="Tryb okna"
                        Margin="8,0,0,0"
                        Click="OnToggleFullScreen" />
                <Button Grid.Column="2" Content="Zakończ" Margin="8,0,0,0" Click="OnExitRequested" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DeviceBox"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="wybierz urządzenie odtwarzające"
                          SelectionChanged="OnDeviceSelectionChanged" />
                <Button Grid.Column="1" Content="Odśwież" Margin="8,0,0,0" Click="OnRefreshDevices" />
                <Button Grid.Column="2" Content="Otwórz tor" Margin="8,0,0,0" Click="OnOpenDevice" />
            </Grid>
            <TextBlock x:Name="DeviceStatus"
                       Margin="0,8,0,0"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="tor nieotwarty" />
        </StackPanel>

        <!-- ── Bodziec i pomiar ──────────────────────────────────────────── -->
        <!-- Pasek przewijania jest widoczny zawsze, takze gdy formularz miesci sie w oknie:
             ma od pierwszego spojrzenia informowac, ze ta kolumna jest dluzsza niz ekran. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,20,0"
                      VerticalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="BODZIEC" Style="{StaticResource SectionHeader}" />

                <TextBlock Text="Częstotliwość [Hz]" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FrequencyBox" Text="1000" InputScope="Number" TextChanged="OnStimulusTextChanged" />

                <TextBlock Text="Poziom sygnału [dBFS]" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LevelBox" Grid.Column="0" Text="-20" InputScope="Number"
                             TextChanged="OnStimulusTextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="−5" Tag="-5" Width="42" Click="OnLevelStep" />
                        <Button Content="−1" Tag="-1" Width="42" Margin="4,0,0,0" Click="OnLevelStep" />
                        <Button Content="+1" Tag="1"  Width="42" Margin="4,0,0,0" Click="OnLevelStep" />
                        <Button Content="+5" Tag="5"  Width="42" Margin="4,0,0,0" Click="OnLevelStep" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Kanał" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="EarLeft" Content="L (lewe)" GroupName="Ear" IsChecked="True" Checked="OnStimulusToggled" />
                    <RadioButton x:Name="EarRight" Content="P (prawe)" GroupName="Ear" Margin="16,0,0,0" Checked="OnStimulusToggled" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="PulsedBox" Content="pulsowany" Checked="OnStimulusToggled" Unchecked="OnStimulusToggled" />
                    <CheckBox x:Name="WarbleBox" Content="wobbulowany" Margin="16,0,0,0" Checked="OnStimulusToggled" Unchecked="OnStimulusToggled" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="PlayButton" Content="Graj" Width="110" Click="OnPlay" IsEnabled="False" />
                    <Button x:Name="StopButton" Content="Stop" Width="110" Margin="8,0,0,0" Click="OnStop" IsEnabled="False" />
                </StackPanel>

                <!-- ── Odczyt z miernika ─────────────────────────────────── -->
                <TextBlock Text="POMIAR" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Zmierzony poziom [dB SPL] — odczyt z miernika klasy 1"
                           Style="{StaticResource FieldLabel}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="MeasuredSplBox" InputScope="Number" TextChanged="OnMeasuredChanged"
                         PlaceholderText="np. 74,3" />

                <TextBlock x:Name="SensitivityPreview"
                           Margin="0,8,0,0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Text="czułość toru: —" />

                <TextBlock Text="Notatka (nieobowiązkowa)" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                <TextBox x:Name="NoteBox" PlaceholderText="np. powtórka po poprawieniu osadzenia" />

                <Button x:Name="AddPointButton"
                        Content="Dodaj pomiar do mapy  →"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Click="OnAddPoint"
                        IsEnabled="False" />

                <!-- ── Metadane sesji ────────────────────────────────────── -->
                <TextBlock Text="SESJA" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Operator" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OperatorBox" />

                <!-- ── Przetwornik ───────────────────────────────────────── -->
                <TextBlock Text="PRZETWORNIK" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Model (określa właściwą tabelę RETSPL)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                <TextBox x:Name="TransducerBox" PlaceholderText="np. TDH-39" />

                <TextBlock Text="Numer seryjny" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="TransducerSerialBox" />

                <TextBlock Text="Poduszki" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <ComboBox x:Name="CushionBox" HorizontalAlignment="Stretch" PlaceholderText="wybierz">
                    <ComboBoxItem Content="supraauralne" />
                    <ComboBoxItem Content="dookołouszne" />
                    <ComboBoxItem Content="douszne" />
                </ComboBox>

                <!-- ── Tor pomiarowy ─────────────────────────────────────── -->
                <TextBlock Text="MIERNIK POZIOMU DŹWIĘKU" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Producent" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MeterManufacturerBox" />

                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="MeterModelBox" />

                <TextBlock Text="Numer seryjny" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="MeterSerialBox" />

                <TextBlock Text="Norma i klasa" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="MeterStandardBox" PlaceholderText="np. IEC 61672-1 klasa 1" />

                <TextBlock Text="Świadectwo wzorcowania — numer" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" TextWrapping="Wrap" />
                <TextBox x:Name="MeterCertificateBox" />

                <TextBlock Text="Świadectwo wzorcowania — data" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" TextWrapping="Wrap" />
                <CalendarDatePicker x:Name="MeterCalibratedOnPicker" HorizontalAlignment="Stretch" PlaceholderText="wybierz datę" />

                <TextBlock Text="Ważenie częstotliwościowe" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <ComboBox x:Name="WeightingBox" HorizontalAlignment="Stretch" PlaceholderText="wybierz">
                    <ComboBoxItem Content="Z" />
                    <ComboBoxItem Content="C" />
                    <ComboBoxItem Content="A" />
                </ComboBox>

                <TextBlock Text="Ważenie czasowe" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <ComboBox x:Name="TimeWeightingBox" HorizontalAlignment="Stretch" PlaceholderText="wybierz">
                    <ComboBoxItem Content="F" />
                    <ComboBoxItem Content="S" />
                </ComboBox>

                <TextBlock Text="Odczytywana wielkość" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <ComboBox x:Name="MeasurementModeBox" HorizontalAlignment="Stretch" PlaceholderText="wybierz">
                    <ComboBoxItem Content="SPL" />
                    <ComboBoxItem Content="Leq" />
                    <ComboBoxItem Content="SPLmax" />
                </ComboBox>

                <TextBlock Text="MIKROFON" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MicModelBox" />

                <TextBlock Text="Numer seryjny" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="MicSerialBox" />

                <TextBlock Text="SPRZĘGACZ" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CouplerBox" PlaceholderText="np. NBS 9A" />

                <TextBlock Text="Numer seryjny" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="CouplerSerialBox" />

                <TextBlock Text="Norma sprzęgacza" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="CouplerStandardBox" PlaceholderText="np. IEC 60318-3" />

                <!-- ── Kalibrator akustyczny ─────────────────────────────── -->
                <TextBlock Text="KALIBRATOR AKUSTYCZNY" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CalibratorModelBox" />

                <TextBlock Text="Numer seryjny" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="CalibratorSerialBox" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Poziom [dB SPL]" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CalibratorLevelBox" InputScope="Number" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Częstotliwość [Hz]" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CalibratorFrequencyBox" InputScope="Number" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Odczyt przed sesją" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox x:Name="CalibratorBeforeBox" InputScope="Number" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Odczyt po sesji" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox x:Name="CalibratorAfterBox" InputScope="Number" />
                    </StackPanel>
                </Grid>

                <!-- ── Warunki ───────────────────────────────────────────── -->
                <TextBlock Text="WARUNKI" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />

                <TextBlock Text="Hałas tła [dB(A)]" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="BackgroundNoiseBox" InputScope="Number" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Temperatura [°C]" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TemperatureBox" InputScope="Number" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Wilgotność [%]" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HumidityBox" InputScope="Number" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Pomieszczenie / stanowisko" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" TextWrapping="Wrap" />
                <TextBox x:Name="LocationBox" />

                <!-- ── Źródła wartości normatywnych ──────────────────────── -->
                <TextBlock Text="ŹRÓDŁA WARTOŚCI NORMATYWNYCH" Style="{StaticResource SectionHeader}" Margin="0,24,0,4" />
                <TextBlock Text="Podaj normę wraz z wydaniem. Narzędzie tych wartości nie zna i ich nie zgaduje — odpowiada za nie operator."
                           Style="{StaticResource FieldLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock Text="RETSPL" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="StdRetsplBox" PlaceholderText="np. ISO 389-1:2017" />

                <TextBlock Text="Tolerancja poziomu" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="StdToleranceBox" />

                <TextBlock Text="Czasy bodźca (narastanie, impuls)" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" TextWrapping="Wrap" />
                <TextBox x:Name="StdTimingBox" />

                <TextBlock Text="Miernik poziomu dźwięku" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="StdMeterBox" />

                <TextBlock Text="Sprzęgacz" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="StdCouplerBox" />

                <TextBlock Text="Dopuszczalny hałas tła" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                <TextBox x:Name="StdAmbientBox" />

                <TextBlock Text="Notatki do pliku kalibracyjnego" Style="{StaticResource FieldLabel}" Margin="0,24,0,2" TextWrapping="Wrap" />
                <TextBox x:Name="NotesBox"
                         AcceptsReturn="True"
                         Height="70"
                         TextWrapping="Wrap"
                         PlaceholderText="pozycja pokręteł M2, przebieg sesji, odstępstwa od procedury" />

                <Border Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── Mapa pomiarów ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="MAPA POMIARÓW" Style="{StaticResource SectionHeader}" />

            <Grid Grid.Row="1" Padding="12,6" Background="{ThemeResource SystemControlBackgroundListLowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Częstotl." FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="1" Text="Kanał" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="2" Text="Poziom" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="3" Text="Zmierzone" FontSize="12" Opacity="0.6" />
                <TextBlock Grid.Column="4" Text="Czułość toru" FontSize="12" Opacity="0.6" />
            </Grid>

            <ListView x:Name="PointsList"
                      Grid.Row="2"
                      SelectionMode="Single"
                      IsDoubleTapEnabled="True"
                      DoubleTapped="OnPointsListDoubleTapped"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalibrationPointRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Frequency}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Ear}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Stimulus}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Measured}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Sensitivity}" FontFamily="Consolas" Opacity="0.75" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="Zaznacz wiersz, aby odtworzyć zapisany bodziec do sprawdzenia. Odtwarzanie z mapy nie zmienia formularza."
                           Style="{StaticResource FieldLabel}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlaySelectedButton" Content="Odtwórz zaznaczony" Click="OnPlaySelected" />
                    <Button Content="Usuń zaznaczony wiersz" Margin="8,0,0,0" Click="OnRemovePoint" />
                    <Button Content="Wczytaj plik kalibracyjny" Margin="24,0,0,0" Click="OnLoadFile" />
                    <Button Content="Zapisz plik kalibracyjny" Margin="8,0,0,0" Click="OnSaveFile" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Pasek stanu ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="VolumeConfirmedBox"
                          Grid.Column="0"
                          Content="Potwierdzam: głośność endpointu Windows ustawiona na 100 %, pokrętła M2 w oznaczonej pozycji"
                          Checked="OnVolumeConfirmationChanged"
                          Unchecked="OnVolumeConfirmationChanged" />
                <Button Grid.Column="1" Content="Selftest przeliczeń" Click="OnSelfTest" />
            </Grid>
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Mapa jest pusta. Wzorcowanie nie jest domknięte, dopóki nie wykonasz kontroli verify (m2cal verify)." />
        </StackPanel>
    </Grid>
</Page>
